# Base URL the browser uses for the API client (src/lib/api/axios.ts).
# Keep "/api" — the app calls its own Next route handlers, which proxy to the
# Django backend server-side (attaching the JWT from the httpOnly cookie).
NEXT_PUBLIC_API_URL=/api

# Server-only: where the Next route handlers reach the Django backend
# (src/lib/api/backend.ts). No NEXT_PUBLIC_ prefix — never exposed to the browser.
BACKEND_API_URL=http://localhost:8000/api
